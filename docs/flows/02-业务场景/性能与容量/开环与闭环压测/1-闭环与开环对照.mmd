    classDef bad fill:#fff1f0,stroke:#cf1322,stroke-width:2px,color:#820014
    classDef legend fill:#fffbe6,stroke:#d4b106,stroke-width:2px
    class K2,LI go
    class CL2 bad
    class LG legend
