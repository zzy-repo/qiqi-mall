%% 多平台接入 · ③与内部系统的边界图
%% 一句话：平台也是一个仓库 —— 两边的台账一一对应，差别只在「谁说了算」
%% 读法：左右两列按①②③④⑤⑥⑦逐行对照着看，读到底部三行再收口
%% 配色：橙＝平台接入这边／蓝＝仓库履约这边／绿＝内部事实／灰虚线＝差异与结论
flowchart TD
    subgraph WH["仓库履约这边：对内，一次交互两行"]
        W1["①对方身份<br/>仓库编码、包裹单号<br/>包裹单号本来就是我们自己生成的"]
        W2["②我方发出什么<br/>下发：包裹、明细、要拣哪几件"]
        W3["③对方回什么<br/>拣货出库结果、运单号、回执报文"]
        W4["④结果分三档<br/>成功／失败／超时<br/>超时单独一档，因为报文可能已经发出去了"]
        W5["⑤第几次尝试<br/>重试就再加一组行<br/>第几次写在行里"]
        W6["⑥耗时<br/>一次往返记毫秒"]
        W7["⑦只追加、不改行<br/>包裹删了证据还在，表上不建外键"]
        W1 --> W2
        W2 --> W3
        W3 --> W4
        W4 --> W5
        W5 --> W6
        W6 --> W7
    end

    subgraph PL["平台接入这边：对外，一次外呼一行"]
        P1["①对方身份<br/>平台店铺、平台单号<br/>都是平台生成的<br/>进内部先过映射表，翻成内部订单号"]
        P2["②我方发出什么<br/>拉单：店铺加水位<br/>回传：平台单号、承运商、运单号"]
        P3["③对方回什么<br/>成批订单报文<br/>或一句结果码"]
        P4["④结果分三档<br/>成功／失败／跳过<br/>跳过＝幂等命中，重复拉单是常态"]
        P5["⑤第几次尝试<br/>回传重试一次就是两行<br/>第几次写在行里"]
        P6["⑥耗时<br/>每次外呼记毫秒"]
        P7["⑦只追加、不改行<br/>店铺与内部订单只做业务引用，表上不建外键"]
        P1 --> P2
        P2 --> P3
        P3 --> P4
        P4 --> P5
        P5 --> P6
        P6 --> P7
    end

    D1["差别一·身份从哪来<br/>平台单号是平台给的<br/>必须靠映射表翻成内部订单号<br/>包裹单号本来就是我们的，不用翻译"]
    D2["差别二·一次交互记几行<br/>仓库先记「要发什么」，再记「回了什么」<br/>两行一组，同属一次尝试<br/>平台一次外呼一行，请求与响应并在一行"]
    D3["差别三·分档与防重<br/>仓库：成功／失败／超时<br/>平台：成功／失败／跳过<br/>仓库靠幂等键防重复记账<br/>平台靠映射表唯一键防重复建单"]

    CONC["所以平台也是一个仓库<br/>外呼、尝试次数、耗时、结果、失败原因<br/>这五样齐了，它就是同一套台账管得住的对象<br/>不必为它另造一套说法<br/>唯一别扭处是买家：渠道单只能挂一个公共账号"]

    P7 --> D1
    W7 --> D1
    D1 --> D2
    D2 --> D3
    D3 --> CONC

    classDef chan fill:#fff3e0,stroke:#ef6c00,stroke-width:1.5px
    classDef wms fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px
    classDef fact fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px
    classDef diff fill:#f5f5f5,stroke:#616161,stroke-width:1.5px
    classDef note fill:#fafafa,stroke:#9e9e9e,stroke-width:1.5px,stroke-dasharray:6 4

    class P1,P2,P3,P4,P5,P6,P7 chan
    class W1,W2,W3,W4,W5,W6,W7 wms
    class D1,D2,D3 diff
    class CONC note
