    classDef go fill:#f6ffed,stroke:#389e0d,stroke-width:2px,color:#135200
    classDef bad fill:#fff1f0,stroke:#cf1322,stroke-width:2px,color:#820014
    class A,B,C,D,J note
    class H go
    class I bad
