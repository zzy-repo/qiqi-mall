erDiagram
    tenant ||--o{ tenant_user : "拥有"
    tenant ||--o{ product : "租户隔离"
    tenant ||--o{ order : "租户隔离"
    tenant ||--o{ tenant_plan : "购买"
    plan ||--o{ tenant_plan : "被订购"

    category ||--o{ category : "父子"
    category ||--o{ product : "归属"
    product_type ||--o{ attribute : "聚合"
    product_type ||--o{ product : "指定"
    product ||--o{ sku : "聚合"

    order ||--o{ order_item : "包含"
    order ||--o| return_apply : "可能产生"
    return_reason ||--o{ return_apply : "被选择"
    order_setting ||..|| order : "全局配置"

    tenant {
        bigint id PK "tenant_id 全局根源"
        varchar name "公司名"
        tinyint status "启用/禁用"
    }
    tenant_user {
        bigint id PK
        bigint tenant_id FK
        varchar username
        varchar password
    }
    plan {
        bigint id PK
        varchar name "基础版/专业版"
        int order_quota "订单量配额"
        decimal price
    }
    tenant_plan {
        bigint id PK
        bigint tenant_id FK
        bigint plan_id FK
        date expire_at "到期时间"
    }
    category {
        bigint id PK
        bigint parent_id "0=顶级"
        varchar name
    }
    product_type {
        bigint id PK
        varchar name
    }
    attribute {
        bigint id PK
        bigint type_id FK
        varchar name
        tinyint is_filter
    }
    product {
        bigint id PK
        bigint tenant_id FK "租户隔离"
        varchar name "SPU"
        bigint category_id FK
        bigint type_id FK
        tinyint publish_status
    }
    sku {
        bigint id PK
        bigint product_id FK "CASCADE"
        varchar spec_json "规格快照"
        decimal price
        int stock
    }
    order {
        bigint id PK
        bigint tenant_id FK "租户隔离"
        varchar order_sn UK
        bigint member_id "买家"
        decimal total_amount
        tinyint status "状态机"
        tinyint pay_type
        datetime payment_time
        varchar receiver_name "收货快照"
    }
    order_item {
        bigint id PK
        bigint order_id FK "CASCADE"
        bigint product_id FK
        bigint product_sku_id FK
        varchar product_name "下单快照"
        decimal product_price "成交价快照"
        int product_quantity
    }
    return_apply {
        bigint id PK
        bigint order_id FK "CASCADE"
        bigint member_id
        varchar return_reason
        varchar description
        tinyint status "待处理/通过/拒绝"
        bigint reason_id FK
    }
    return_reason {
        bigint id PK
        varchar name "质量问题/不想要了"
    }
    order_setting {
        bigint id PK
        int auto_confirm_days "自动收货天数"
        int auto_close_minutes "未付款关单"
    }
