erDiagram
    商品分类 ||--o{ 商品分类 : "父子层级"
    商品分类 ||--o{ 商品 : "归属分类"
    商品类型 ||--o{ 属性 : "聚合属性"
    商品类型 ||--o{ 商品 : "指定类型"
    商品 ||--o{ SKU : "聚合 SKU"

    商品分类 {
        bigint id PK
        bigint parent_id "0=顶级，自引用"
        varchar name
    }
    商品类型 {
        bigint id PK
        varchar name "手机/服装/食品"
    }
    属性 {
        bigint id PK
        bigint type_id FK "聚合于类型"
        varchar name
        tinyint is_filter "是否筛选属性"
    }
    商品 {
        bigint id PK
        bigint tenant_id FK "租户隔离"
        varchar name "SPU"
        bigint category_id FK
        bigint type_id FK
        tinyint publish_status "1上架 0下架"
    }
    SKU {
        bigint id PK
        bigint product_id FK "聚合于商品，CASCADE"
        varchar spec_json "规格如{颜色:黑}"
        decimal price
        int stock
    }
