erDiagram
    商品分类 ||--o{ 商品分类 : "父子层级"
    商品分类 ||--o{ 商品 : "归属分类"
    商品类型 ||--o{ 属性 : "聚合属性"
    商品类型 ||--o{ 商品 : "指定类型"
    商品 ||--o{ SKU : "聚合SKU"
    SKU ||--o{ SKU规格值 : "规格明细"
    属性 ||--o{ SKU规格值 : "被引用"
    商品 ||--o{ 商品相册 : "多张详情图"

    商品分类 {
        bigint id PK
        bigint parent_id "0=顶级自引用"
        varchar name
    }
    商品类型 {
        bigint id PK
        varchar name "手机服装食品"
    }
    属性 {
        bigint id PK
        bigint type_id FK "聚合于类型"
        varchar name
        tinyint is_filter "是否筛选属性"
    }
    商品 {
        bigint id PK
        varchar name "SPU"
        bigint category_id FK
        bigint type_id FK
        varchar pic "主图URL指向MinIO"
        tinyint publish_status "1上架0下架"
    }
    SKU {
        bigint id PK
        bigint product_id FK "聚合于商品CASCADE"
        decimal price
        int stock
        varchar pic "SKU图URL指向MinIO"
    }
    SKU规格值 {
        bigint id PK
        bigint sku_id FK "聚合于SKU CASCADE"
        bigint attribute_id FK "指向属性定义"
        varchar value "属性值如黑色"
    }
    商品相册 {
        bigint id PK
        bigint product_id FK "聚合于商品CASCADE"
        varchar url "图片URL指向MinIO"
        int sort "展示顺序"
    }
