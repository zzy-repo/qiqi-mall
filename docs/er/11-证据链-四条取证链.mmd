%% 取证链 · 四条（这张是流水，不是字段级图）
%% 为什么单独一张：域图画的是数据结构，这张画的是控制流——状态与判定是怎么被记下来的。
%% 阅读顺序从上到下：写入点散落 → 收敛成唯一入口 → 落进同一套列契约 → 能被对账证伪；
%% 第五条带是另一条取证链：审核决策，它是新模块，从第一天就按台账口径建。
%% 这张图不出现任何状态取值数字、接口路径与类名，只讲"谁写、写到哪、怎么验"。
flowchart TB
    subgraph S1["一 · 改之前"]
        direction LR
        a1["订单状态写入十七处<br/>其中真实流转十五处"]
        a2["包裹状态写入九处<br/>其中真实流转七处"]
        a3["售后状态写入三处<br/>其中绕过统一赋值直写一处"]
        a4["后台敏感操作<br/>改价删单拆单合并发货退货审核<br/>全部无留痕"]
        a0["所以只有当前值<br/>任何一次变更都查不到历史"]
        a1 --> a0
        a2 --> a0
        a3 --> a0
        a4 --> a0
    end
    subgraph S2["二 · 收敛"]
        direction LR
        b1["订单流转入口<br/>先校验当前状态再写库"]
        b2["包裹流转入口"]
        b3["售后流转入口"]
        b4["审计留痕入口<br/>一次请求一条"]
    end
    subgraph S3["三 · 落账"]
        direction LR
        c1["订单状态台账<br/>十四列同构"]
        c2["包裹状态台账<br/>十四列同构"]
        c3["售后处理台账<br/>十四列同构"]
        c4["操作审计日志<br/>只追加"]
    end
    subgraph S4["四 · 可证伪"]
        direction LR
        d1["订单状态等于台账最新一行"]
        d2["缓存时间与台账一致"]
        d3["退款金额不超过支付金额"]
        d4["每次外发都有结果回执"]
    end
    subgraph S5["五 · 审核决策（天生带账）"]
        direction LR
        direction LR
        e1["审核批次<br/>定时触发才写幂等键"]
        e2["订单审核决策<br/>每单每轮一行·只追加"]
        e3["订单状态台账<br/>决策行按流转序号对得上"]
        e4["四条对账照用<br/>从决策能反查到状态那一行"]
        e1 --> e2
        e2 --> e3
        e3 --> e4
    end

    a1 --> b1
    a2 --> b2
    a3 --> b3
    a4 --> b4
    b1 --> c1
    b2 --> c2
    b3 --> c3
    b4 --> c4
    c1 --> d1
    c2 --> d2
    c3 --> d3
    c4 --> d4
    d1 ~~~ e1

    style S1 fill:#fdeceb,stroke:#d4736f
    style S2 fill:#fff3e3,stroke:#dd9a4e
    style S3 fill:#e9f7ee,stroke:#5fae7c
    style S4 fill:#e8f1fb,stroke:#6b9bd2
    style S5 fill:#fde9f1,stroke:#c9548f
