erDiagram
    订单 ||--o{ 订单明细 : "包含明细"
    订单 ||--o| 退货申请 : "可能产生退货"
    退货原因 ||--o{ 退货申请 : "被选择"
    订单设置 ||..|| 订单 : "全局配置"
    商品 ||--o{ 订单明细 : "快照引用"
    SKU ||--o{ 订单明细 : "快照引用"
    会员 ||--o{ 订单 : "下单"
    会员 ||--o{ 退货申请 : "申请退货"

    会员 {
        bigint id PK
        varchar username UK "登录名-全局唯一"
        varchar password "BCrypt"
        varchar nickname
        varchar phone
        tinyint status "1启用 0禁用"
        datetime create_time
    }
    订单 {
        bigint id PK
        varchar order_sn UK "订单号-全局唯一"
        bigint member_id FK "买家，指向会员表"
        decimal total_amount
        tinyint status "0待付款1已付款2已发货3已完成4已关闭5退款中6已退款"
        tinyint pay_type "0未支付 1支付宝 2微信"
        datetime payment_time
        varchar receiver_name "收货人快照"
        varchar receiver_phone "收货电话快照"
        varchar receiver_address "收货地址快照"
    }
    订单明细 {
        bigint id PK
        bigint order_id FK "CASCADE"
        bigint product_id FK "SPU"
        bigint product_sku_id FK "SKU"
        varchar product_name "下单时快照"
        decimal product_price "成交价快照"
        int product_quantity
    }
    退货申请 {
        bigint id PK
        bigint order_id FK "聚合于订单，CASCADE"
        bigint member_id FK "申请人"
        varchar return_reason
        varchar description "详细说明"
        tinyint status "0待处理 1通过 2拒绝"
        bigint reason_id FK
    }
    退货原因 {
        bigint id PK
        varchar name "质量问题/七天无理由/发错货/不想要了"
    }
    支付流水 {
        bigint id PK
        varchar order_sn "关联订单号,对账键(索引,无外键)"
        decimal amount
        tinyint type "1支付 2退款"
        tinyint channel "1支付宝 2微信 0模拟"
        varchar trade_no "第三方流水号(模拟为本地生成)"
        datetime created_at
    }
    订单 ||--o{ 支付流水 : "产生流水"
    退货申请 ||--o| 支付流水 : "产生退款流水"
    订单设置 {
        bigint id PK
        int auto_confirm_days "自动收货天数"
        int auto_close_minutes "未付款自动关单分钟"
    }
