erDiagram
    会员 ||--o{ 订单 : "下单"
    会员 ||--o{ 退货申请 : "申请退货"
    会员 ||--o| 购物车 : "添加"
    商品 ||--o{ 购物车 : "被加入"
    SKU ||--o{ 购物车 : "选中规格"
    会员 ||--o{ 收货地址 : "维护"

    会员 {
        bigint id PK
        varchar username UK "登录名-全局唯一"
        varchar password "BCrypt"
        varchar nickname
        varchar phone
        tinyint status "1启用 0禁用"
        datetime create_time
    }
    收货地址 {
        bigint id PK
        bigint member_id FK "聚合于会员"
        varchar name "收件人"
        varchar phone
        varchar province
        varchar city
        varchar region
        varchar detail "详细地址"
        tinyint default_status "是否默认地址"
    }
    购物车 {
        bigint id PK
        bigint member_id FK
        bigint product_id FK "SPU"
        bigint product_sku_id FK "具体规格"
        int quantity "数量"
        datetime create_time "加入时间"
    }
    管理员 {
        bigint id PK
        varchar username UK "后台登录名"
        varchar password "BCrypt"
        varchar nickname
        varchar email
        tinyint status "1启用 0禁用"
        datetime create_time
    }
