erDiagram
    租户 ||--o{ 租户用户 : "拥有"
    租户 ||--o{ 租户套餐订阅 : "购买订阅"
    套餐 ||--o{ 租户套餐订阅 : "被订购"
    租户 ||--o{ 商品 : "隔离商品"
    租户 ||--o{ 订单 : "隔离订单"

    租户 {
        bigint id PK "tenant_id 全局根源"
        varchar name "公司名"
        tinyint status "1启用 0禁用"
    }
    租户用户 {
        bigint id PK
        bigint tenant_id FK "所属租户"
        varchar username
        varchar password
    }
    套餐 {
        bigint id PK
        varchar name "基础版/专业版"
        int order_quota "订单量配额"
        decimal price
    }
    租户套餐订阅 {
        bigint id PK
        bigint tenant_id FK
        bigint plan_id FK
        date expire_at "到期时间"
    }
    商品 {
        bigint id PK "含 tenant_id 隔离字段"
    }
    订单 {
        bigint id PK "含 tenant_id 隔离字段"
    }
