digraph flow {
    rankdir=TB;
    splines=polyline;
    nodesep=0.5; ranksep=0.55;
    fontname="Noto Sans CJK SC";
    node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12, penwidth=1.3, margin="0.2,0.12"];
    edge [fontname="Noto Sans CJK SC", fontsize=10, penwidth=1.3, color="#444444"];

    req   [label="HTTP 请求\nHeader: X-Tenant-Id", shape=note, fillcolor="#FFF8DC", color="#C9A227"];
    ti    [label="TenantInterceptor\nX-Tenant-Id → ThreadLocal", fillcolor="#DDF2E3", color="#5A9E6F"];
    tp    [label="TenantLineInnerInterceptor\nproduct / order 自动拼 WHERE tenant_id", fillcolor="#DDF2E3", color="#5A9E6F"];
    ctrl  [label="Controllers\n商品 · 分类 · 类型 · 属性 · SKU · 订单 · 明细\n退货 · 设置 · 租户 · 套餐", fillcolor="#DDF2E3", color="#5A9E6F"];
    svc   [label="Service / Mapper（MyBatis-Plus）", fillcolor="#DDF2E3", color="#5A9E6F"];

    subgraph cluster_db {
        label="qiqi_mall"; labeljust="l";
        style="rounded"; color="#7B68EE"; bgcolor="#F5F3FF";
        biz    [label="业务表\ncategory · product_type · attribute\nproduct · sku（tenant_id）· order · order_item\nreturn_apply · return_reason · order_setting", fillcolor="#E6E1FF", color="#7B68EE"];
        ten    [label="租户表\ntenant · tenant_user · plan · tenant_plan", fillcolor="#E6E1FF", color="#7B68EE"];
    }

    resp  [label="Result<T> 统一响应\n{code, message, data}", shape=note, fillcolor="#FFF8DC", color="#C9A227"];

    req -> ti -> tp -> ctrl -> svc;
    svc -> biz [label="隔离表：自动过滤"];
    svc -> ten [label="全局表：不过滤"];
    ctrl -> resp [style=dotted];
    { rank=same; biz; ten; }
}
