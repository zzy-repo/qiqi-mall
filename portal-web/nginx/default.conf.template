# 真实客户端 IP 透传：公网请求经过 ECS Caddy → Tailscale → 本机 nginx 两层代理。
#
# 【为什么不再按源 IP 判断可信】上一版用 geo 白名单（127.0.0.1 / 172.16.0.0/12 /
# 100.114.12.76）来筛「谁有资格给 X-Real-IP」，实测发现这条路走不通：从 tailscale0
# 进来的包会被 Tailscale 的
#     -A ts-postrouting -m mark --mark 0x40000/0xff0000 -j MASQUERADE
# （配合 docker 发布端口的 DNAT）抹掉源地址，到了容器里一律呈现为 172.21.0.1。
# 而 172.21.0.1 正落在 172.16.0.0/12 里面 ⇒ 100.114.12.76/32 那条规则永远不命中，
# 真正生效的只有那条宽网段；于是 tailnet 上任何设备（手机/笔记本/别的服务器）打
# 5174/5176/18080，源地址同样呈现为 172.21.0.1 = 「可信」，照样能伪造 X-Real-IP。
# 源 IP 在这条链路上无法区分来源，白名单形同虚设。
#
# 【现在的做法】不靠源 IP，靠共享密钥头（HTTP 头能穿过 SNAT）：
#   ECS 的 Caddy 反代前先 request_header 删掉客户端自带的 X-Qiqi-Proxy-Secret，
#   再 header_up 写入自己的密钥；本机 nginx 只认「带了正确密钥」的上游，
#   其它来源一律忽略它给的 X-Real-IP、改用直连地址（$remote_addr）。
# 密钥只存在于 ECS 的 Caddyfile 与本文件的 map 里，tailnet 其它设备无从得知。
# 链路有两跳：Caddy → 前端容器 → gateway（两个前端容器再反代到 gateway），
# 两跳都用同一个密钥：前端容器判定出 $qiqi_client_ip 后，要重新写一遍密钥头再交给
# gateway，否则 gateway 只看到前端容器 IP（172.21.x.x），真实 IP 就丢了。
# 注意：map 必须放在 http/server 作用域之外（本文件在 conf.d 下被 http 层 include）。
# 另外 X-Forwarded-For 也只发 $qiqi_client_ip 这一个值（不再用 $proxy_add_x_forwarded_for 追加）：
# 追加会把客户端自带的伪造值留在最左边，而 Spring 侧 ClientIp 取最左段、
# ForwardedHeaderFilter 也按最左段改写 remoteAddr，等于绕过下面的判定。
# 密钥是 64 位十六进制，作为 map 的 key 会超出默认的 map_hash_bucket_size（64），
# 不调大启动直接 [emerg] could not build map_hash。128 足够放下 64 字符 key。
map_hash_bucket_size 128;

map $http_x_qiqi_proxy_secret $qiqi_trusted_proxy {
    default    0;
    "5df2ba780d65e6fe9364244abca7aa1a1ef945a9a1b7f386d19a5cb0d41b2d55" 1;
}

map "$qiqi_trusted_proxy:$http_x_real_ip" $qiqi_client_ip {
    default          $remote_addr;      # 不可信来源：忽略它给的头，用直连地址
    "1:"             $remote_addr;      # 可信来源但没给头：用直连地址
    "~^1:.+$"        $http_x_real_ip;   # 可信来源且给了头：采信
}

server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # 图片上传（前端 nginx 的默认 1MB 会把 5MB 图片直接拦成 413 HTML）
    client_max_body_size 6m;

    # gzip
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 静态资源长缓存（文件名带 hash）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # C 端接口反向代理到后端容器（/portal/**）
    location /portal/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        # 本容器 → gateway 这一跳同样是「不可信来源」（gateway 只认密钥头），
        # 所以这里要把本容器判定出的 $qiqi_client_ip 用密钥头背书给 gateway，
        # 否则 gateway 会把来源当成前端容器 IP（172.21.x.x），真实 IP 丢掉。
        proxy_set_header X-Qiqi-Proxy-Secret "5df2ba780d65e6fe9364244abca7aa1a1ef945a9a1b7f386d19a5cb0d41b2d55";
        # Spring 的 ForwardedHeaderFilter 优先认 RFC 7239 的 Forwarded 头（比 XFF 优先级高），一并清掉
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $qiqi_client_ip;
        # 单值 XFF：只用可信来源解析出的地址（见文件头说明）
        proxy_set_header X-Forwarded-For $qiqi_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }


    # 商品图片：库里存相对路径 /qiqi-mall/**（历史数据 + 新上传都是这个形式），
    # test 链路的上传端已经指向阿里云 OSS（bucket qiqi-mall-static 的 qiqi-mall/ 前缀），
    # 所以读取端必须落到同一个存储 —— 这里 301 到 CDN（源站就是该 bucket）。
    # 用 301 而不是让后端返回 CDN 绝对地址：库里的相对路径一个字都不用改，前后端都不用动。
    # 也不用 proxy_pass 回源：让浏览器直连 CDN，省掉本机出网流量与回源延迟。
    location /qiqi-mall/ {
        # $request_uri 保留原始 /qiqi-mall/** 路径（bucket 内的 key 前缀与之一一对应）
        return 301 ${IMG_CDN_BASE}$request_uri;
    }

    # history 路由回退
    # ★ index.html 绝不缓存：容器是索引的唯一来源（JS/CSS 已上 CDN），浏览器启发式缓存
    #   会让发版后的用户仍拿旧 index，指向已下线的 hash 资源 → 白屏。静态资源不受影响
    #   （/assets/ 走上面的 30d + immutable，文件名带 hash）。
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
