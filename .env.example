APP_ENV=dev
MYSQL_ROOT_PASSWORD=qiqi123456
# JWT 签名密钥（生产务必替换为随机长字符串，至少 32 字节）
JWT_SECRET=qiqi-mall-prod-secret-key-please-change-9876543210
# MinIO（图片存储）
MINIO_ACCESS_KEY=qiqiadmin
MINIO_SECRET_KEY=qiqi123456
# 浏览器访问 MinIO 的地址（部署机固定 IP 时改成 http://<IP>:9000）
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# 进程外 KV 档位：memory（单实例，默认）| redis（多实例共享验证码/幂等令牌）
KV_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
