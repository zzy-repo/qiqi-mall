APP_ENV=dev
MYSQL_ROOT_PASSWORD=qiqi123456
# JWT 签名密钥（生产务必替换为随机长字符串，至少 32 字节）
JWT_SECRET=qiqi-mall-prod-secret-key-please-change-9876543210
# MinIO（图片存储）
MINIO_ACCESS_KEY=qiqiadmin
MINIO_SECRET_KEY=qiqi123456
# 浏览器访问 MinIO 的地址（部署机固定 IP 时改成 http://<IP>:9000）
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# 进程外 KV 档位：memory（单实例，默认）| redis（多实例共享验证码/幂等令牌）
KV_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 测试环境（容器栈 /test profile）对象存储：阿里云 OSS ----------
# 只填占位，真实值放宿主机 /root/.aliyun-qiqi/credentials.env 或项目根 .env（已 gitignore），绝不入库
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=https://s3.oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=qiqi-mall-static
# 商品图 /qiqi-mall/** 的重定向目标（前端 nginx 301 到该 CDN，源站 = 上面的 OSS bucket）
IMG_CDN_BASE=https://cdn.rose7.cn
