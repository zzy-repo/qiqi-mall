# 真实客户端 IP 透传：公网请求经过 ECS Caddy → Tailscale → 本机 nginx 两层代理，
# 直连对端（$remote_addr）已经是 ECS 的 Tailscale IP，真实访客 IP 只存在于上游给的
# X-Real-IP / X-Forwarded-For 里。
#
# 安全前提：这些端口（5174/5176/18080）都监听 0.0.0.0，局域网 + tailnet 都可达，
# 所以「上游给了 X-Real-IP 就采信」等于内网任何人都能伪造来源 IP（污染日志，
# 一旦做 IP 限流/黑名单就是绕过）。因此只采信可信代理白名单给出的头：
#   - 127.0.0.1/32     本机回环
#   - 172.16.0.0/12    docker 内部网段（前端容器 → gateway → server 都是这里）
#   - 100.114.12.76/32 阿里云 ECS（Tailscale IP），公网流量的唯一入口
# 注意：tailnet 整体是 100.64.0.0/10，这里刻意只放 ECS 单个 IP，
# 避免 tailnet 内其它设备（手机/笔记本）也能伪造来源 IP。
# 注意：geo / map 必须放在 http/server 作用域之外（本文件在 conf.d 下被 http 层 include）。
# 另外 X-Forwarded-For 也只发 $qiqi_client_ip 这一个值（不再用 $proxy_add_x_forwarded_for 追加）：
# 追加会把客户端自带的伪造值留在最左边，而 Spring 侧 ClientIp 取最左段、
# ForwardedHeaderFilter 也按最左段改写 remoteAddr，等于绕过上面的白名单。
geo $qiqi_trusted_proxy {
    default           0;
    127.0.0.1/32      1;
    172.16.0.0/12     1;
    100.114.12.76/32  1;
}

map "$qiqi_trusted_proxy:$http_x_real_ip" $qiqi_client_ip {
    default          $remote_addr;      # 不可信来源：忽略它给的头，用直连地址
    "1:"             $remote_addr;      # 可信来源但没给头：用直连地址
    "~^1:.+$"        $http_x_real_ip;   # 可信来源且给了头：采信
}

server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # 图片上传（前端 nginx 的默认 1MB 会把 5MB 图片直接拦成 413 HTML）
    client_max_body_size 6m;

    # gzip
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 静态资源长缓存（文件名带 hash）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 管理后台接口反向代理到后端容器（/admin/**）
    location /admin/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $qiqi_client_ip;
        # 单值 XFF：只用可信来源解析出的地址（见文件头说明）
        proxy_set_header X-Forwarded-For $qiqi_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }


    # 商品图片：MinIO 直出。库里存相对路径 /qiqi-mall/**，所以从任何地址访问都能取到图
    location /qiqi-mall/ {
        # 注意：proxy_pass 不带 URI，原样透传 /qiqi-mall/** 给 MinIO（bucket 名就在路径里）
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $qiqi_client_ip;
        expires 7d;
    }

    # history 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
