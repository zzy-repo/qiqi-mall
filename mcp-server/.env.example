# 后端网关地址（容器栈默认 18080）
MALL_BASE=http://127.0.0.1:18080

# API Key（必填）：按库隔离 —— dev 库一把、test 库一把，换库就换 key
# 造 key：scripts/init-ai-key.sh（明文只打印一次，别提交进仓库）
MALL_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 测试环境（18080 / qiqi_mall_test）的那把：
#   MALL_API_KEY=$(cat /tmp/test-env-ai-key.txt)

# 写开关：0=只注册只读工具（订单 6 + 商品域 6 = 12 个）；1=再加 1 个写工具（会改数据的 execute_audit_pass，共 13 个）
MCP_ENABLE_WRITE=0
